<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened Runtime resource-access entitlement for Photos. Not a restricted
       entitlement, so no provisioning profile is needed. Deliberately NO
       keychain-access-groups / application-identifier: those need a profile (note C9). -->
  <key>com.apple.security.personal-information.photos-library</key><true/>
</dict>
</plist>
